TELEGRAM_BOT_TOKEN=put-token-here
TELEGRAM_ALLOWED_USER_ID=123456789
PI_WORKDIR=/path/to/workdir
PI_TIMEOUT_SECONDS=1800
DROP_PENDING_UPDATES_ON_START=false
TELEGRAM_PARSE_MODE=MarkdownV2
UPLOAD_RETENTION_HOURS=48
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_DEFAULT_LANGUAGE=auto
STT_COMMAND=.venv/bin/python scripts/transcribe_voice.py
PI_EXTRA_PATH=/home/debian/.local/bin:/opt/node-v22.22.2-linux-x64/bin
PI_COMMAND=pi --mode json
PI_RESUME_COMMAND=pi --mode json
