<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.telegram-pi-yolo-cli-bot</string>
  <key>WorkingDirectory</key>
  <string>/path/to/telegram-pi-yolo-cli-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/path/to/telegram-pi-yolo-cli-bot/bot.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/path/to/telegram-pi-yolo-cli-bot/state/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/telegram-pi-yolo-cli-bot/state/launchd.err.log</string>
</dict>
</plist>
